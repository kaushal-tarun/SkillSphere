generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  university String?

  username   String?  @unique
  bio        String?
  avatar     String?
  xp         Int      @default(0)

  createdAt  DateTime @default(now())
}